<!DOCTYPE html>
<html lang="{{ .LanguageCode }}" dir="{{ .Direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .MetaTitle }} - {{ .PageTitle }}</title>
    <meta name="description" content="{{ .MetaDescription }}">
    <meta name="author" content="{{ .MetaAuthor }}">
    <link rel="icon" href="{{ pathjoin .ActionEndpoint "/assets/images/favicon.svg" }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/google-webfonts/roboto.css" }}">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/oidc.css" }}">

    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/basic.css" }}">
    {{ if .CustomCSSEnabled }}<link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/custom.css" }}">{{ end }}
  </head>
  <body class="basic-theme oidc-page">
    <div class="oidc-shell">
      <div class="oidc-brand">{{ if .LogoURL }}<img src="{{ .LogoURL }}" alt="{{ .LogoDescription }}">{{ end }}<span>{{ .MetaTitle }}</span></div>
      {{ with .Data.oidc }}
    <main class="oidc-card" aria-labelledby="oidc-title">
      <div class="brand-banner" aria-hidden="true"></div>
      <header class="oidc-header">
        <p class="oidc-eyebrow">{{ if eq .Kind "consent" }}{{ .Translate "oidc_application_access" }}{{ else if eq .Kind "form_post" }}{{ .Translate "oidc_return_to_application" }}{{ else }}{{ .Translate "oidc_sign_in_request" }}{{ end }}</p>
        <h1 id="oidc-title">{{ .Title }}</h1>
        {{ if eq .Kind "consent" }}
        <p class="oidc-intro">{{ .Translate "oidc_client_request" }} <strong class="oidc-client" dir="auto">{{ .ClientName }}</strong></p>
        <div class="oidc-account"><span class="oidc-account-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/></svg></span><div><span class="oidc-account-label">{{ .Translate "oidc_signed_in_as" }}</span><strong class="oidc-username" dir="auto">{{ .Username }}</strong></div></div>
        {{ else if eq .Kind "form_post" }}
        <p class="oidc-intro">{{ .Translate "oidc_continue_instruction" }} <strong class="oidc-client" dir="auto">{{ .ClientName }}</strong></p>
        {{ else }}
        <p class="oidc-intro" role="alert">{{ .Message }}</p>
        {{ end }}
      </header>
      {{ if eq .Kind "consent" }}
      <section class="oidc-permissions" aria-labelledby="oidc-permissions-title">
        <h2 id="oidc-permissions-title">{{ .Translate "oidc_review_access" }}</h2>
        <ul class="oidc-permission-list">
          {{ range .Permissions }}
          <li><span class="oidc-permission-mark" aria-hidden="true">&#8226;</span><div><h3>{{ .Title }}</h3><p>{{ .Description }}</p></div></li>
          {{ end }}
        </ul>
        {{ if .UserInfoClaims }}
        <div class="oidc-claims"><h3>{{ .Translate "oidc_additional_information" }}</h3><p>{{ .Translate "oidc_additional_access" }}</p><ul>{{ range .UserInfoClaims }}<li>{{ . }}</li>{{ end }}</ul></div>
        {{ end }}
        {{ if .IDTokenClaims }}
        <div class="oidc-claims"><h3>{{ .Translate "oidc_sign_in_information" }}</h3><p>{{ .Translate "oidc_direct_information" }}</p><ul>{{ range .IDTokenClaims }}<li>{{ . }}</li>{{ end }}</ul></div>
        {{ end }}
      </section>
      <footer class="oidc-footer">
        <p class="oidc-notice">{{ .Translate "oidc_trust_notice" }}</p>
        <form method="post" action="{{ .Action }}" class="oidc-actions">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <button class="oidc-button oidc-button-primary" type="submit" name="decision" value="allow">{{ .Translate "oidc_allow_access" }}</button>
          <button class="oidc-button oidc-button-secondary" type="submit" name="decision" value="deny">{{ .Translate "deny_action" }}</button>
        </form>
        <p class="oidc-footnote">{{ .Translate "oidc_deny_notice" }}</p>
      </footer>
      {{ else if eq .Kind "form_post" }}
      <footer class="oidc-footer">
        <form id="response" method="post" action="{{ .Action }}">
          {{ range $key, $values := .Values }}{{ range $values }}<input type="hidden" name="{{ $key }}" value="{{ . }}">{{ end }}{{ end }}
          <button class="oidc-button oidc-button-primary oidc-button-wide" type="submit">{{ .Translate "continue_action" }}</button>
        </form>
        <p class="oidc-footnote">{{ .Translate "oidc_manual_continue" }}</p>
        <noscript><p class="oidc-footnote">{{ .Translate "oidc_noscript" }}</p></noscript>
      </footer>
      {{ end }}
    </main>
    {{ if eq .Kind "form_post" }}<script nonce="{{ .Nonce }}">document.getElementById('response').submit();</script>{{ end }}
      {{ end }}
    </div>
  </body>
</html>
