{{- $title := .PageTitle -}}
{{- if eq .Data.view "activate" }}{{ $title = .Translate "cross_device_activate_title" }}
{{- else if eq .Data.view "confirm" }}{{ $title = .Translate "cross_device_confirm_title" }}
{{- else if eq .Data.view "approve" }}{{ $title = .Translate "cross_device_approved_title" }}
{{- else if eq .Data.view "deny" }}{{ $title = .Translate "cross_device_denied_title" }}{{ end -}}
<!DOCTYPE html>
<html lang="{{ .LanguageCode }}" dir="{{ .Direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .MetaTitle }} - {{ $title }}</title>
    <meta name="description" content="{{ .MetaDescription }}">
    <meta name="author" content="{{ .MetaAuthor }}">
    <link rel="icon" href="{{ pathjoin .ActionEndpoint "/assets/images/favicon.svg" }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/google-webfonts/roboto.css" }}">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/generic.css" }}">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/basic.css" }}">
    {{ if .CustomCSSEnabled }}<link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/custom.css" }}">{{ end }}
  </head>
  <body class="basic-theme">
    <div class="app-page">
      <div class="app-content">
        <main class="app-container cross-device-page" aria-labelledby="cross-device-title">
          <div class="brand-banner" aria-hidden="true"></div>
          <header class="brand-heading">
            {{ if .LogoURL }}<img class="logo-img" src="{{ .LogoURL }}" alt="{{ .LogoDescription }}">{{ end }}
            <h1 id="cross-device-title" tabindex="-1">{{ $title }}</h1>
          </header>
          <div class="cross-device-flow">
          {{ if eq .Data.view "request" }}
          <div class="cross-device-flow" id="cross-device-details" hidden>
            <p class="brand-message">{{ .Translate "cross_device_scan_instruction" }}</p>
            <img id="cross-device-qr" alt="{{ .Translate "cross_device_qr_alt" }}" width="256" height="256">
            <div class="cross-device-code-panel">
              <p class="cross-device-hint">{{ .Translate "cross_device_match_code" }}</p>
              <strong class="cross-device-code" dir="ltr" id="cross-device-code"></strong>
            </div>
          </div>
          <p class="brand-message cross-device-status" id="cross-device-status" role="status">{{ .Translate "cross_device_preparing" }}</p>
          <div id="cross-device-controls">
            <div class="cross-device-actions">
              <button class="app-btn-sec" id="cross-device-copy" type="button" disabled>{{ .Translate "copy_link_action" }}</button>
              <button class="app-btn-sec" id="cross-device-cancel" type="button">{{ .Translate "cancel_action" }}</button>
            </div>
            <p class="cross-device-hint" id="cross-device-copy-status" role="status"></p>
            <div class="cross-device-manual" id="cross-device-link-fallback" hidden>
              <label for="cross-device-link">{{ .Translate "sign_in_link_label" }}</label>
              <textarea dir="ltr" id="cross-device-link" rows="3" readonly spellcheck="false" aria-describedby="cross-device-copy-status"></textarea>
            </div>
          </div>
          <div id="cross-device-recovery" hidden>
            <a class="app-btn-pri" href="{{ pathjoin .ActionEndpoint "/cross-device" }}">{{ .Translate "start_again_action" }}</a>
          </div>
          <noscript><p>{{ .Translate "cross_device_javascript_required" }}</p></noscript>
          {{ else if eq .Data.view "activate" }}
          <p class="brand-message">{{ .Translate "cross_device_activate_instruction" }}</p>
          <div class="cross-device-code-panel">
            <p class="cross-device-hint">{{ .Translate "cross_device_match_code" }}</p>
            <strong class="cross-device-code" dir="ltr" id="cross-device-code">{{ .Data.display }}</strong>
          </div>
          <p class="brand-message">{{ .Translate "cross_device_activate_next" }}</p>
          <form class="cross-device-actions" method="post" action="{{ pathjoin .ActionEndpoint "/cross-device/begin" }}">
            <input type="hidden" name="code" value="{{ .Data.code }}">
            <input type="hidden" name="csrf" value="{{ .Data.csrf }}">
            <button class="app-btn-pri" type="submit">{{ .Translate "continue_action" }}</button>
          </form>
          {{ else if eq .Data.view "confirm" }}
          <p class="brand-message">{{ .Translate "cross_device_account_instruction" }}</p>
          <p><strong class="cross-device-account" dir="auto">{{ .Data.account }}</strong></p>
          <div class="cross-device-code-panel">
            <p class="cross-device-hint">{{ .Translate "cross_device_match_code" }}</p>
            <strong class="cross-device-code" dir="ltr" id="cross-device-code">{{ .Data.display }}</strong>
          </div>
          <p class="brand-message">{{ .Translate "cross_device_approve_instruction" }}</p>
          <form class="cross-device-actions" method="post" action="{{ pathjoin .ActionEndpoint "/cross-device/confirm" }}">
            <input type="hidden" name="csrf" value="{{ .Data.csrf }}">
            <button class="app-btn-pri" name="decision" value="approve" type="submit">{{ .Translate "approve_action" }}</button>
            <button class="app-btn-sec" name="decision" value="deny" type="submit">{{ .Translate "deny_action" }}</button>
          </form>
          {{ else if eq .Data.view "approve" }}
          <p class="brand-message" role="status">{{ .Translate "cross_device_approved_instruction" }}</p>
          {{ else }}
          <p class="brand-message" role="status">{{ .Translate "cross_device_denied_instruction" }}</p>
          {{ end }}
          </div>
          <div class="brand-actions"><a href="{{ pathjoin .ActionEndpoint "/login" }}">{{ .Translate "back_to_sign_in" }}</a></div>
        </main>
      </div>
    </div>
    {{ if eq .Data.view "request" }}<script src="{{ pathjoin .ActionEndpoint "/assets/js/cross_device.js" }}" data-i18n="{{ .Messages "cross_device_approved_title" "cross_device_cancelled" "cross_device_cancelled_title" "cross_device_continuing" "cross_device_copied" "cross_device_copy_manual" "cross_device_copy_selected" "cross_device_ended" "cross_device_ended_title" "cross_device_expired" "cross_device_expired_title" "cross_device_start_failed" "cross_device_start_failed_title" "cross_device_unavailable" "cross_device_unavailable_title" "cross_device_waiting" }}" data-base="{{ .ActionEndpoint }}"></script>{{ end }}
  </body>
</html>
