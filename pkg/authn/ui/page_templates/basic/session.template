<!DOCTYPE html>
<html lang="{{ .LanguageCode }}" dir="{{ .Direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .MetaTitle }} - {{ .PageTitle }}</title>
    <meta name="description" content="{{ .MetaDescription }}">
    <meta name="author" content="{{ .MetaAuthor }}">
    <link rel="icon" href="{{ pathjoin .ActionEndpoint "/assets/images/favicon.svg" }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/google-webfonts/roboto.css" }}">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/generic.css" }}">
    <link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/basic.css" }}">
    {{ if .CustomCSSEnabled }}<link rel="stylesheet" href="{{ pathjoin .ActionEndpoint "/assets/css/custom.css" }}">{{ end }}
  </head>
  <body class="basic-theme">
    <div class="app-page">
      <div class="app-content">
        <main class="app-container" aria-labelledby="session-title">
          <div class="brand-banner" aria-hidden="true"></div>
          <header class="brand-heading">
            {{ if .LogoURL }}<img class="logo-img" src="{{ .LogoURL }}" alt="{{ .LogoDescription }}">{{ end }}
            <h1 id="session-title">{{ .PageTitle }}</h1>
          </header>
          <p class="brand-message" id="session-message">{{ .Message }}</p>
          <div class="brand-actions">
            {{ if eq .Data.session_action "logout" }}<button class="app-btn-pri" id="session-logout" type="button">{{ .Translate "sign_out" }}</button>{{ end }}
            <a href="{{ pathjoin .ActionEndpoint "/login" }}?fresh=1">{{ .Translate "sign_in" }}</a>
          </div>
          <noscript><p class="brand-message">{{ .Translate "session_javascript_required" }}</p></noscript>
        </main>
      </div>
    </div>
    <script src="{{ pathjoin .ActionEndpoint "/assets/js/refresh.js" }}" data-i18n="{{ .Messages "session_browser_unsupported" "session_incomplete" "session_interrupted" "session_logout_failed" "session_logout_unconfirmed" "session_sign_in_again" }}" data-base="{{ .ActionEndpoint }}" data-action="{{ .Data.session_action }}" data-next="{{ .Data.session_next }}"></script>
  </body>
</html>
