<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Title }}</title>
    <style nonce="{{ .Nonce }}">.oidc-page{margin:0;background:#edf3fc;color:#172b4d;font:16px/1.55 system-ui,sans-serif}.oidc-shell{max-width:580px;margin:48px auto;padding:0 16px}.oidc-card{background:white;border:1px solid #dce4ef;border-radius:16px;box-shadow:0 12px 40px #17376312;overflow:hidden}.oidc-header,.oidc-permissions,.oidc-footer{padding:28px}.oidc-permissions,.oidc-footer{border-top:1px solid #dce4ef}.oidc-eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:#245bca}.oidc-page h1{font-size:28px;line-height:1.25;margin:0}.oidc-page h2,.oidc-page h3{font-size:16px;margin:0}.oidc-intro,.oidc-permission-list p,.oidc-claims p,.oidc-footnote{color:#52637a}.oidc-intro,.oidc-username,.oidc-client{overflow-wrap:anywhere}.oidc-account{display:flex;align-items:center;gap:12px;padding:12px;background:#f1f5fa;border-radius:8px}.oidc-account-icon svg{width:24px;height:24px}.oidc-account-label,.oidc-username{display:block}.oidc-account-label,.oidc-footnote{font-size:12px}.oidc-permission-list{list-style:none;padding:0}.oidc-permission-list>li{display:flex;gap:12px;margin-top:16px}.oidc-permission-mark{color:#245bca}.oidc-permission-list p{margin:4px 0;font-size:14px}.oidc-claims{margin-top:20px}.oidc-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px}.oidc-button{font:inherit;padding:12px;border-radius:8px;border:1px solid #b8c6d9;cursor:pointer;min-height:46px}.oidc-button-primary{background:#245bca;color:white;border-color:#245bca}.oidc-button-secondary{background:white;color:#172b4d}.oidc-button:focus-visible{outline:3px solid #477cdc;outline-offset:3px}.oidc-button-wide{width:100%}@media(max-width:480px){.oidc-shell{margin:24px auto}.oidc-header,.oidc-permissions,.oidc-footer{padding:24px}}</style>
  </head>
  <body class="oidc-page">
    <div class="oidc-shell">
    <main class="oidc-card" aria-labelledby="oidc-title">
      <header class="oidc-header">
        <p class="oidc-eyebrow">{{ if eq .Kind "consent" }}Application access{{ else if eq .Kind "form_post" }}Return to application{{ else }}Sign-in request{{ end }}</p>
        <h1 id="oidc-title">{{ .Title }}</h1>
        {{ if eq .Kind "consent" }}
        <p class="oidc-intro"><strong class="oidc-client">{{ .ClientName }}</strong> would like to access your account.</p>
        <div class="oidc-account"><span class="oidc-account-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/></svg></span><div><span class="oidc-account-label">Signed in as</span><strong class="oidc-username">{{ .Username }}</strong></div></div>
        {{ else if eq .Kind "form_post" }}
        <p class="oidc-intro">Continue to <strong class="oidc-client">{{ .ClientName }}</strong> to finish this request.</p>
        {{ else }}
        <p class="oidc-intro" role="alert">{{ .Message }}</p>
        {{ end }}
      </header>
      {{ if eq .Kind "consent" }}
      <section class="oidc-permissions" aria-labelledby="oidc-permissions-title">
        <h2 id="oidc-permissions-title">Review requested access</h2>
        <ul class="oidc-permission-list">
          {{ range .Permissions }}
          <li><span class="oidc-permission-mark" aria-hidden="true">&#8226;</span><div><h3>{{ .Title }}</h3><p>{{ .Description }}</p></div></li>
          {{ end }}
        </ul>
        {{ if .UserInfoClaims }}
        <div class="oidc-claims"><h3>Additional information</h3><p>The application can also access:</p><ul>{{ range .UserInfoClaims }}<li>{{ . }}</li>{{ end }}</ul></div>
        {{ end }}
        {{ if .IDTokenClaims }}
        <div class="oidc-claims"><h3>Included when you sign in</h3><p>These details will be sent directly to the application:</p><ul>{{ range .IDTokenClaims }}<li>{{ . }}</li>{{ end }}</ul></div>
        {{ end }}
      </section>
      <footer class="oidc-footer">
        <p class="oidc-notice">Only continue if you trust this application.</p>
        <form method="post" action="{{ .Action }}" class="oidc-actions">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <button class="oidc-button oidc-button-primary" type="submit" name="decision" value="allow">Allow access</button>
          <button class="oidc-button oidc-button-secondary" type="submit" name="decision" value="deny">Deny</button>
        </form>
        <p class="oidc-footnote">Choosing Deny returns you to the application without granting access.</p>
      </footer>
      {{ else if eq .Kind "form_post" }}
      <footer class="oidc-footer">
        <form id="response" method="post" action="{{ .Action }}">
          {{ range $key, $values := .Values }}{{ range $values }}<input type="hidden" name="{{ $key }}" value="{{ . }}">{{ end }}{{ end }}
          <button class="oidc-button oidc-button-primary oidc-button-wide" type="submit">Continue</button>
        </form>
        <p class="oidc-footnote">If you are not redirected automatically, select Continue.</p>
        <noscript><p class="oidc-footnote">Automatic redirection is unavailable. You can continue using the button above.</p></noscript>
      </footer>
      {{ end }}
    </main>
    {{ if eq .Kind "form_post" }}<script nonce="{{ .Nonce }}">document.getElementById('response').submit();</script>{{ end }}
    </div>
  </body>
</html>
